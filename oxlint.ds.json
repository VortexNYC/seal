{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": [
    "**/.blume/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "**/dist/**"
  ],
  "rules": {
    "shadcn/no-raw-colors": [
      "error",
      {
        "message": "Use the theme token (e.g. bg-*/text-* names from styles.css), or declare a new --color-* there. ADR-002.",
        "allow": [
          "text-label",
          "*:text-label",
          "text-lede",
          "*:text-lede",
          "text-lead",
          "*:text-lead",
          "text-display",
          "*:text-display",
          "bg-hero-glow",
          "*:bg-hero-glow",
          "bg-fade-muted",
          "*:bg-fade-muted",
          "border-field",
          "*:border-field"
        ]
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "message": "Off-token value \u2014 use the spacing scale, a --text-*/--radius-*/--tracking-* token, or a named @utility in styles.css."
      }
    ],
    "shadcn/no-inline-styles": "warn",
    "shadcn/require-static-classes": "warn",
    "shadcn/no-restyle": [
      "warn",
      {
        "componentImports": ["@cloudflare/kumo/components/*"],
        "allow": ["layout"],
        "message": "Kumo primitives own their look \u2014 prefer size/variant props over visual restyling. ADR-002."
      }
    ]
  }
}
