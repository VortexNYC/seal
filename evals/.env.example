# Seal AI Eval Environment
# Copy to .env and fill in values

# Convex deployment URL (required) — defaults to wooden-poodle-362 dev deployment
# CONVEX_SITE_URL=https://wooden-poodle-362.convex.site

# Vercel AI Gateway API key (required for llm-rubric grading)
# Same gateway used in production — get key at vercel.com/dashboard → AI Gateway
AI_GATEWAY_API_KEY=
# promptfoo reads OPENAI_API_KEY for llm-rubric grading — set to same AI Gateway key
OPENAI_API_KEY=
