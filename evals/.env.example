# Seal AI Eval Environment
# Copy to .env and fill in values

# Convex deployment URL (required) — defaults to wooden-poodle-362 dev deployment
# CONVEX_SITE_URL=https://wooden-poodle-362.convex.site

# Google Generative AI API key (required for llm-rubric grading)
# Get a free key at: https://aistudio.google.com/apikey
# Without this, all llm-rubric assertions will fail with auth errors
GOOGLE_GENERATIVE_AI_API_KEY=
