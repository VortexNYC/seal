{
  "name": "@seal/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir ../.. run lint:convex && convex dev",
    "deploy": "pnpm --dir ../.. run lint:convex && convex deploy",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit -p ./convex/tsconfig.json",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "clean": "git clean -xdf .cache .turbo node_modules convex/_generated"
  },
  "dependencies": {
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/action-retrier": "^0.3.0",
    "@convex-dev/agent": "^0.6.3",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/better-auth": "0.12.2",
    "@convex-dev/migrations": "^0.3.3",
    "@convex-dev/presence": "^0.3.0",
    "@convex-dev/rag": "^0.7.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.3.9",
    "@convex-dev/workpool": "^0.4.7",
    "@posthog/convex": "^2.0.28",
    "@seal/transactional": "workspace:*",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@vortexnyc/auth": "0.16.0",
    "@vortexnyc/convex": "0.8.0",
    "@vortexnyc/money": "0.2.2",
    "@vortexnyc/observability": "0.2.0",    "@vortexnyc/payments-sdk": "0.1.2",
    "ai": "^6.0.146",
    "better-auth": "1.6.9",
    "convex": "catalog:",
    "convex-helpers": "^0.1.114",
    "convex-timeline": "^0.1.2",
    "nanoid": "^5.1.7",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "standardwebhooks": "1.0.0",
    "unpdf": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.46",
    "vitest": "catalog:"
  }
}
