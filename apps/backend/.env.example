# Backend (Convex) Environment Variables
# These are set via the Convex dashboard or CLI — NOT in a local .env file.
#
#   convex env set VARIABLE_NAME value
#   convex env ls
#
# Or via the dashboard: https://dashboard.convex.dev → your deployment → Settings → Environment Variables
#
# The only local file needed is .env.local, which Convex CLI creates automatically
# during `convex dev` to store your CONVEX_DEPLOYMENT name.

# ── Dev Eval Gate ───────────────────────────────────────────────────────────
DEV_EVAL_SECRET=  # set on dev/test deployments to enable /dev/* eval endpoints; leave unset in prod

# ── Stripe ────────────────────────────────────────────────────────────────────
# Found at: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Found at: Stripe dashboard → Developers → Webhooks → your endpoint → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Found at: Stripe dashboard → Connect → Settings → Client ID
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe price lookup key used for auto-enrolling new users (e.g. "free:personal:monthly:v1")
DEFAULT_PLAN_LOOKUP_KEY=free:personal:monthly:v1
# Set to "true" to automatically enroll new users on the free plan at signup
AUTO_ENROLL_FREE_PLAN_ON_SIGNUP=true

# ── Vortex Billing ───────────────────────────────────────────────────────────
# Base URL and API key used by Vortex Billing checkout, payables, and webhooks.
VORTEX_BILLING_API_BASE_URL=https://api.vortex.nyc
VORTEX_BILLING_API_KEY=vtx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret for Vortex Billing HTTP actions.
VORTEX_BILLING_WEBHOOK_SECRET=vtx_whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SaaS subscription cutover allowlist. Use [] for Stripe fallback, or ["org_..."] for Vortex.
VORTEX_BILLING_SAAS_ORGANIZATION_IDS=["org_seal_123"]
# Default Vortex Billing account id for SaaS subscriptions and shared payable flows.
VORTEX_BILLING_ACCOUNT_ID=bacc_seal_123
# Optional per-organization Vortex Billing account override map: {orgId:vortexBillingAccountId}.
VORTEX_BILLING_ACCOUNT_MAP={"org_seal_123":"bacc_seal_123"}
# SaaS price catalog map: {lookupKey:vortexPriceId}. Seed these ids with apps/backend/scripts/seed-vortex-saas-catalog.ts.
VORTEX_BILLING_SAAS_PRICE_MAP={"pro:monthly:v2":"price_seal_pro_monthly_v2"}
# Optional per-organization Vortex customer override map: {orgId:vortexCustomerExternalId}.
VORTEX_BILLING_CUSTOMER_MAP={"org_seal_123":"vtx_cust_seal_org_org_seal_123"}

# Shared payable/document bridge namespace and allowlists.
VORTEX_BILLING_SOURCE_NAMESPACE=seal
VORTEX_BILLING_PAYABLE_ORGANIZATION_IDS=["org_seal_123"]
VORTEX_BILLING_DOCUMENT_PAYMENT_ORGANIZATION_IDS=["org_seal_123"]
# Shared and document-specific price maps: {sealPriceKey:vortexPriceId}.
VORTEX_BILLING_PRICE_MAP={"document:standard":"price_seal_document_standard"}
VORTEX_BILLING_DOCUMENT_PRICE_MAP={"document:standard":"price_seal_document_standard"}
# Document-specific account/customer overrides; shared ACCOUNT_* and CUSTOMER_MAP are used as fallback.
VORTEX_BILLING_DOCUMENT_ACCOUNT_ID=bacc_seal_123
VORTEX_BILLING_DOCUMENT_ACCOUNT_MAP={"org_seal_123":"bacc_seal_123"}
VORTEX_BILLING_DOCUMENT_CUSTOMER_MAP={"org_seal_123":"vtx_cust_seal_org_org_seal_123"}
# Merchant account routing for Vortex Payments-backed payable collection.
VORTEX_BILLING_MERCHANT_ACCOUNT_ID=macc_seal_123
VORTEX_BILLING_MERCHANT_ACCOUNT_MAP={"org_seal_123":"macc_seal_123"}
VORTEX_BILLING_DOCUMENT_MERCHANT_ACCOUNT_ID=macc_seal_123
VORTEX_BILLING_DOCUMENT_MERCHANT_ACCOUNT_MAP={"org_seal_123":"macc_seal_123"}
# Payment environment sent to Vortex for merchant/payment capability checks.
VORTEX_BILLING_PAYMENTS_ENVIRONMENT=test

# ── Resend (Transactional Email) ──────────────────────────────────────────────
# Found at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notifications@yourdomain.com

# ── App URLs ──────────────────────────────────────────────────────────────────
# URL of the product web app — used for email links and redirects
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
# Canonical URL of the product app — used for certificate verification links
SITE_URL=https://app.yourdomain.com
# Public HTTP Actions base URL for this Convex deployment
# Found at: Convex dashboard → your deployment → Settings → URL & Deploy Key
CONVEX_SITE_URL=https://your-deployment.convex.site
# Allowed CORS origin for HTTP Actions (set to your app URL in production)
CLIENT_ORIGIN=https://app.yourdomain.com

# ── Security ──────────────────────────────────────────────────────────────────
# AES-256 encryption key for signature data (must be exactly 32 characters)
SIGNATURE_ENCRYPTION_KEY=your-32-character-encryption-key!!
# Shared secret for internal backend ↔ MCP server communication
MCP_INTERNAL_SECRET=your-mcp-internal-secret-here
