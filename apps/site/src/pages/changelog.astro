---
import Base from "../layouts/Base.astro";
import { changelog } from "../data/changelog";

export const prerender = true;
---

<Base title={changelog.title} description={changelog.description}>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="logo" aria-label="Seal home">
        <svg viewBox="0 0 200 200" width="26" height="26" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M50 154 C58 108 88 62 152 40 C146 90 116 136 62 146 Z" stroke-width="9"/>
          <path d="M42 166 C84 124 120 78 152 40" stroke-width="6"/>
          <path d="M74 130 C84 127 92 122 98 114" stroke-width="5"/>
          <path d="M104 92 C114 89 122 84 128 76" stroke-width="5"/>
        </svg>
        <span class="logo-word">Seal</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="https://docs.seal.nyc">Docs</a>
        <a href="/changelog" aria-current="page">Changelog</a>
      </div>
      <div class="nav-actions">
        <a class="btn btn-ink" href="https://app.seal.nyc/sign-up?next=developer">Get an API key</a>
      </div>
    </div>
  </nav>

  <main class="changelog">
    <div class="container">
      <p class="eyebrow">Changelog</p>
      <h1>What shipped</h1>
      <p class="lede">{changelog.description}</p>

      <ol class="posts">
        {changelog.posts.map((post) => (
          <li class="post" id={post.slug}>
            <time datetime={post.date}>{post.date}</time>
            <h2>{post.title}</h2>
            <p class="summary">{post.summary}</p>
            {post.body.map((para) => <p>{para}</p>)}
          </li>
        ))}
      </ol>
    </div>
  </main>
</Base>

<style>
  .nav {
    border-bottom: 1px solid color-mix(in oklab, var(--foreground) 12%, transparent);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0;
  }
  .container {
    width: min(720px, calc(100% - 2rem));
    margin-inline: auto;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .logo-word {
    font-family: var(--font-serif, "Instrument Serif", serif);
    font-size: 1.25rem;
  }
  .nav-links {
    display: flex;
    gap: 1rem;
    flex: 1;
  }
  .nav-links a {
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
  }
  .nav-links a[aria-current="page"] {
    opacity: 1;
    font-weight: 600;
  }
  .btn {
    display: inline-flex;
    padding: 0.5rem 0.9rem;
    border-radius: 0.35rem;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .btn-ink {
    background: var(--primary, #44403c);
    color: var(--primary-foreground, #fafaf9);
  }
  .changelog {
    padding: 3rem 0 5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    opacity: 0.6;
    margin: 0 0 0.5rem;
  }
  h1 {
    font-family: var(--font-serif, "Instrument Serif", serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    margin: 0 0 0.75rem;
  }
  .lede {
    opacity: 0.75;
    margin: 0 0 2.5rem;
    max-width: 40rem;
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }
  .post time {
    display: block;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    opacity: 0.55;
    margin-bottom: 0.35rem;
  }
  .post h2 {
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
  }
  .summary {
    font-weight: 500;
    margin: 0 0 0.75rem;
  }
  .post p {
    margin: 0 0 0.65rem;
    line-height: 1.55;
    opacity: 0.9;
  }
</style>
