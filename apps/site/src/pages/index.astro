---
import Base from "../layouts/Base.astro";
import { landing } from "../data/landing";
---

<Base title={landing.title} description={landing.description}>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="logo" aria-label="Seal home">
        <svg viewBox="0 0 64 64" width="28" height="28" aria-hidden="true">
          <circle cx="32" cy="32" r="30" fill="var(--primary)"></circle>
          <circle cx="32" cy="32" r="24" fill="none" stroke="#fafaf9" stroke-width="1.5" opacity="0.6"></circle>
          <text x="32" y="42" text-anchor="middle" font-family="Georgia, serif" font-size="30" fill="#fafaf9">S</text>
        </svg>
        <span class="logo-word serif">Seal</span>
      </a>
      <div class="nav-links">
        {landing.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="nav-actions">
        <a class="btn-ghost" href={landing.nav.signIn.href}>{landing.nav.signIn.label}</a>
        <a class="btn-primary" href={landing.nav.cta.href}>{landing.nav.cta.label}</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="container">
      <p class="eyebrow">{landing.hero.eyebrow}</p>
      <h1 class="serif">
        {landing.hero.headline}<br />
        <em>{landing.hero.headlineEmphasis}</em>
      </h1>
      <p class="sub">{landing.hero.subheadline}</p>
      <div class="hero-ctas">
        <a class="btn-primary btn-lg" href={landing.hero.primaryCta.href}>{landing.hero.primaryCta.label}</a>
        <a class="btn-ghost btn-lg" href={landing.hero.secondaryCta.href}>{landing.hero.secondaryCta.label}</a>
      </div>
      <ul class="proof">
        {landing.hero.proof.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </header>

  <section id="product" class="features">
    {
      landing.features.map((f, i) => (
        <div class={`container feature ${i % 2 === 1 ? "feature-flip" : ""}`}>
          <div class="feature-copy">
            <p class="eyebrow">{f.eyebrow}</p>
            <h2 class="serif">{f.title}</h2>
            <p class="feature-body">{f.body}</p>
            <ul class="feature-bullets">
              {f.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
          <div class="feature-visual" aria-hidden="true">
            <div class="doc-card">
              <div class="doc-line w-70" />
              <div class="doc-line w-90" />
              <div class="doc-line w-55" />
              <div class="doc-gap" />
              <div class="doc-line w-90" />
              <div class="doc-line w-40" />
              <div class="doc-seal">
                <svg viewBox="0 0 64 64" width="44" height="44">
                  <circle cx="32" cy="32" r="30" fill="var(--primary)" opacity="0.92" />
                  <circle cx="32" cy="32" r="24" fill="none" stroke="#fafaf9" stroke-width="1.5" opacity="0.7" />
                </svg>
                <span class="mono">Signed</span>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <section id="developers" class="developer">
    <div class="container dev-inner">
      <div class="dev-copy">
        <p class="eyebrow">{landing.developer.eyebrow}</p>
        <h2 class="serif">{landing.developer.title}</h2>
        <p>{landing.developer.body}</p>
        <ul class="endpoints">
          {landing.developer.endpoints.map((e) => <li class="mono">{e}</li>)}
        </ul>
      </div>
      <pre class="code"><code>{landing.developer.codeSnippet}</code></pre>
    </div>
  </section>

  <section class="comparison">
    <div class="container">
      <h2 class="serif">{landing.comparison.title}</h2>
      <p class="comparison-sub">{landing.comparison.subtitle}</p>
      <div class="compare-table">
        <div class="compare-head">
          <span class="mono">Them</span>
          <span class="mono">Seal</span>
        </div>
        {
          landing.comparison.rows.map((r) => (
            <div class="compare-row">
              <span class="them">{r.them}</span>
              <span class="seal">{r.seal}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-inner">
      <svg viewBox="0 0 64 64" width="56" height="56" aria-hidden="true">
        <circle cx="32" cy="32" r="30" fill="var(--primary)"></circle>
        <circle cx="32" cy="32" r="24" fill="none" stroke="#fafaf9" stroke-width="1.5" opacity="0.6"></circle>
        <text x="32" y="42" text-anchor="middle" font-family="Georgia, serif" font-size="30" fill="#fafaf9">S</text>
      </svg>
      <h2 class="serif">{landing.finalCta.headline}</h2>
      <p>{landing.finalCta.sub}</p>
      <a class="btn-primary btn-lg" href={landing.finalCta.cta.href}>{landing.finalCta.cta.label}</a>
      <p class="final-note mono">{landing.finalCta.note}</p>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="logo-word serif">Seal</span>
        <p>{landing.footer.tagline}</p>
      </div>
      <div class="footer-cols">
        {
          landing.footer.columns.map((col) => (
            <div class="footer-col">
              <h4 class="mono">{col.title}</h4>
              {col.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="container footer-legal">
      <span class="mono">© 2026 Seal · Made in New York City</span>
    </div>
  </footer>
</Base>

<style>
  .nav {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--background);
    z-index: 10;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-word {
    font-size: 24px;
  }
  .nav-links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    color: var(--muted-foreground);
    flex: 1;
  }
  .nav-links a:hover {
    color: var(--foreground);
  }
  .nav-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-block;
    border-radius: var(--radius);
    font-size: 14px;
    font-weight: 600;
    padding: 9px 18px;
    transition: opacity 0.15s;
  }
  .btn-primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .btn-primary:hover {
    opacity: 0.9;
  }
  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--foreground);
    background: var(--card);
  }
  .btn-ghost:hover {
    border-color: var(--muted-foreground);
  }
  .btn-lg {
    padding: 13px 26px;
    font-size: 15px;
  }

  .hero {
    padding: 120px 0 96px;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1.04;
    margin: 24px auto 0;
    max-width: 15ch;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--primary);
  }
  .hero .sub {
    max-width: 58ch;
    margin: 28px auto 0;
    font-size: 18px;
    color: var(--muted-foreground);
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-top: 40px;
  }
  .proof {
    display: flex;
    gap: 28px;
    justify-content: center;
    list-style: none;
    margin-top: 36px;
    font-size: 13px;
    color: var(--muted-foreground);
  }
  .proof li::before {
    content: "·";
    color: var(--primary);
    margin-right: 8px;
    font-weight: 700;
  }

  .features {
    padding: 40px 0;
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    padding: 96px 24px;
    border-top: 1px solid var(--border);
  }
  .feature-flip .feature-copy {
    order: 2;
  }
  .feature-copy h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    margin: 16px 0 20px;
    max-width: 20ch;
  }
  .feature-body {
    color: var(--muted-foreground);
    font-size: 17px;
    max-width: 48ch;
  }
  .feature-bullets {
    list-style: none;
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }
  .feature-bullets li {
    padding-left: 24px;
    position: relative;
    font-size: 15px;
  }
  .feature-bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--primary);
  }
  .feature-visual {
    display: flex;
    justify-content: center;
  }
  .doc-card {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 8.5 / 11;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 24px 60px -24px rgba(26, 23, 20, 0.18);
    padding: 40px 32px;
    position: relative;
  }
  .doc-line {
    height: 10px;
    border-radius: 5px;
    background: var(--secondary);
    margin-bottom: 14px;
  }
  .doc-line.w-70 { width: 70%; }
  .doc-line.w-90 { width: 90%; }
  .doc-line.w-55 { width: 55%; }
  .doc-line.w-40 { width: 40%; }
  .doc-gap { height: 90px; }
  .doc-seal {
    position: absolute;
    right: 28px;
    bottom: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .developer {
    background: var(--foreground);
    color: oklch(0.982 0.002 90);
    padding: 120px 0;
  }
  .dev-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .developer .eyebrow {
    color: oklch(0.78 0.09 30);
  }
  .dev-copy h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    margin: 16px 0 20px;
  }
  .dev-copy p {
    color: oklch(0.8 0.01 80);
    font-size: 17px;
  }
  .endpoints {
    list-style: none;
    margin-top: 28px;
    display: grid;
    gap: 8px;
    font-size: 13px;
    color: oklch(0.7 0.02 80);
  }
  .endpoints li::before {
    content: "→ ";
    color: var(--brand-400);
  }
  .code {
    background: oklch(0.19 0.01 65);
    border: 1px solid oklch(0.28 0.01 65);
    border-radius: var(--radius);
    padding: 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
    color: oklch(0.9 0.02 80);
  }

  .comparison {
    padding: 120px 0;
  }
  .comparison h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    text-align: center;
  }
  .comparison-sub {
    text-align: center;
    color: var(--muted-foreground);
    margin-top: 12px;
  }
  .compare-table {
    margin: 56px auto 0;
    max-width: 860px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }
  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .compare-head {
    background: var(--secondary);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .compare-head span,
  .compare-row span {
    padding: 16px 24px;
  }
  .compare-row {
    border-top: 1px solid var(--border);
    font-size: 15px;
  }
  .compare-row .them {
    color: var(--muted-foreground);
    border-right: 1px solid var(--border);
  }
  .compare-row .seal {
    font-weight: 500;
  }
  .compare-head span:first-child {
    border-right: 1px solid var(--border);
  }

  .final-cta {
    padding: 120px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .final-inner h2 {
    font-size: clamp(36px, 5vw, 56px);
    margin: 24px 0 12px;
  }
  .final-inner > p {
    color: var(--muted-foreground);
    font-size: 17px;
  }
  .final-inner .btn-lg {
    margin-top: 32px;
  }
  .final-note {
    margin-top: 20px;
    font-size: 12px;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 32px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }
  .footer-brand p {
    color: var(--muted-foreground);
    font-size: 14px;
    margin-top: 8px;
    max-width: 28ch;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .footer-col h4 {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 14px;
  }
  .footer-col a {
    display: block;
    font-size: 14px;
    color: var(--muted-foreground);
    padding: 4px 0;
  }
  .footer-col a:hover {
    color: var(--foreground);
  }
  .footer-legal {
    margin-top: 56px;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
    .feature,
    .dev-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 64px 24px;
    }
    .feature-flip .feature-copy {
      order: 0;
    }
    .feature-visual {
      order: -1;
    }
    .doc-card {
      max-width: 300px;
    }
    .compare-head,
    .compare-row {
      grid-template-columns: 1fr;
    }
    .compare-row .them {
      border-right: none;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 8px;
    }
    .compare-row .seal {
      padding-top: 8px;
    }
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero {
      padding: 80px 0 64px;
    }
  }
</style>
