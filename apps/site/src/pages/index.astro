---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import { landing } from "../data/landing";
---

<Base title={landing.title} description={landing.description}>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="logo" aria-label="Seal home">
        <svg viewBox="0 0 64 64" width="28" height="28" aria-hidden="true">
          <circle cx="32" cy="32" r="30" fill="var(--primary)"></circle>
          <circle cx="32" cy="32" r="24" fill="none" stroke="#fafaf9" stroke-width="1.5" opacity="0.6"></circle>
          <text x="32" y="42" text-anchor="middle" font-family="Georgia, serif" font-size="30" fill="#fafaf9">S</text>
        </svg>
        <span class="logo-word serif">Seal</span>
      </a>
      <div class="nav-links">
        {landing.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="nav-actions">
        <a class="btn-ghost" href={landing.nav.signIn.href}>{landing.nav.signIn.label}</a>
        <a class="btn-primary" href={landing.nav.cta.href}>{landing.nav.cta.label}</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="container">
      <p class="eyebrow">{landing.hero.eyebrow}</p>
      <h1 class="serif">
        {landing.hero.headline}<br />
        <em>{landing.hero.headlineEmphasis}</em>
      </h1>
      <p class="sub">{landing.hero.subheadline}</p>
      <div class="hero-ctas">
        <a class="btn-primary btn-lg" href={landing.hero.primaryCta.href}>{landing.hero.primaryCta.label}</a>
        <a class="btn-ghost btn-lg" href={landing.hero.secondaryCta.href}>{landing.hero.secondaryCta.label}</a>
      </div>
      <ul class="proof">
        {landing.hero.proof.map((p) => <li>{p}</li>)}
      </ul>
      <div class="code-window">
        <div class="code-titlebar">
          <span class="code-dots" aria-hidden="true"><i /><i /><i /></span>
          <span class="mono">{landing.hero.codeFile}</span>
          <span class="mono code-host">api.seal.nyc</span>
        </div>
        <Code code={landing.hero.codeSnippet} lang="ts" theme="github-dark-default" />
      </div>
    </div>
  </header>

  <section id="api" class="api">
    <div class="container">
      <p class="eyebrow">{landing.api.eyebrow}</p>
      <h2 class="serif">{landing.api.title}</h2>
      <p class="api-body">{landing.api.body}</p>
      <div class="endpoint-table">
        {
          landing.api.endpoints.map((e) => (
            <div class="endpoint-row">
              <span class={`mono method method-${e.method.toLowerCase()}`}>{e.method}</span>
              <span class="mono endpoint-path">{e.path}</span>
              <span class="endpoint-desc">{e.desc}</span>
            </div>
          ))
        }
      </div>
      <p class="api-footer">{landing.api.footer}</p>
    </div>
  </section>

  <section id="pricing" class="pricing">
    <div class="container">
      <p class="eyebrow">{landing.pricing.eyebrow}</p>
      <h2 class="serif">{landing.pricing.title}</h2>
      <p class="pricing-sub">{landing.pricing.subtitle}</p>
      <div class="tiers">
        {
          landing.pricing.tiers.map((t) => (
            <div class={`tier ${t.featured ? "tier-featured" : ""}`}>
              <h3 class="tier-name">{t.name}</h3>
              <div class="tier-price">
                <span class="serif">{t.price}</span>
                <span class="mono tier-unit">{t.unit}</span>
              </div>
              <p class="tier-blurb">{t.blurb}</p>
              <ul class="tier-features">
                {t.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a
                class={t.featured ? "btn-primary tier-cta" : "btn-ghost tier-cta"}
                href={t.cta.href}
              >
                {t.cta.label}
              </a>
            </div>
          ))
        }
      </div>
      <p class="pricing-note mono">{landing.pricing.note}</p>
    </div>
  </section>

  <section id="developers" class="developer">
    <div class="container dev-inner">
      <div class="dev-copy">
        <p class="eyebrow">{landing.developer.eyebrow}</p>
        <h2 class="serif">{landing.developer.title}</h2>
        <p>{landing.developer.body}</p>
        <ul class="endpoints">
          {landing.developer.endpoints.map((e) => <li class="mono">{e}</li>)}
        </ul>
      </div>
      <div class="dev-panel" aria-hidden="true">
        <div class="mcp-card">
          <div class="mcp-row"><span class="mono mcp-method">MCP</span><span class="mono">mcp.seal.nyc</span></div>
          <div class="mcp-msg">documents.send({`{ title: "Mutual NDA", … }`})</div>
          <div class="mcp-msg mcp-ok">→ sent · signing link emailed to jane@acme.com</div>
        </div>
      </div>
    </div>
  </section>

  <section class="comparison">
    <div class="container">
      <h2 class="serif">{landing.comparison.title}</h2>
      <p class="comparison-sub">{landing.comparison.subtitle}</p>
      <div class="compare-table">
        <div class="compare-head">
          <span class="mono">Them</span>
          <span class="mono">Seal</span>
        </div>
        {
          landing.comparison.rows.map((r) => (
            <div class="compare-row">
              <span class="them">{r.them}</span>
              <span class="seal">{r.seal}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-inner">
      <svg viewBox="0 0 64 64" width="56" height="56" aria-hidden="true">
        <circle cx="32" cy="32" r="30" fill="var(--primary)"></circle>
        <circle cx="32" cy="32" r="24" fill="none" stroke="#fafaf9" stroke-width="1.5" opacity="0.6"></circle>
        <text x="32" y="42" text-anchor="middle" font-family="Georgia, serif" font-size="30" fill="#fafaf9">S</text>
      </svg>
      <h2 class="serif">{landing.finalCta.headline}</h2>
      <p>{landing.finalCta.sub}</p>
      <a class="btn-primary btn-lg" href={landing.finalCta.cta.href}>{landing.finalCta.cta.label}</a>
      <p class="final-note mono">{landing.finalCta.note}</p>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="logo-word serif">Seal</span>
        <p>{landing.footer.tagline}</p>
      </div>
      <div class="footer-cols">
        {
          landing.footer.columns.map((col) => (
            <div class="footer-col">
              <h4 class="mono">{col.title}</h4>
              {col.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="container footer-legal">
      <span class="mono">© 2026 Seal · Made in New York City</span>
    </div>
  </footer>
</Base>

<style>
  .nav {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--background);
    z-index: 10;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-word {
    font-size: 24px;
  }
  .nav-links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    color: var(--muted-foreground);
    flex: 1;
  }
  .nav-links a:hover {
    color: var(--foreground);
  }
  .nav-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-block;
    border-radius: var(--radius);
    font-size: 14px;
    font-weight: 600;
    padding: 9px 18px;
    transition: opacity 0.15s;
    text-align: center;
  }
  .btn-primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .btn-primary:hover {
    opacity: 0.9;
  }
  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--foreground);
    background: var(--card);
  }
  .btn-ghost:hover {
    border-color: var(--muted-foreground);
  }
  .btn-lg {
    padding: 13px 26px;
    font-size: 15px;
  }

  .hero {
    padding: 104px 0 96px;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1.04;
    margin: 24px auto 0;
    max-width: 15ch;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--primary);
  }
  .hero .sub {
    max-width: 58ch;
    margin: 28px auto 0;
    font-size: 18px;
    color: var(--muted-foreground);
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-top: 40px;
  }
  .proof {
    display: flex;
    gap: 28px;
    justify-content: center;
    list-style: none;
    margin-top: 32px;
    font-size: 13px;
    color: var(--muted-foreground);
  }
  .proof li::before {
    content: "·";
    color: var(--primary);
    margin-right: 8px;
    font-weight: 700;
  }

  .code-window {
    margin: 56px auto 0;
    max-width: 720px;
    text-align: left;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid oklch(0.28 0.01 65);
    background: oklch(0.17 0.012 65);
    box-shadow: 0 32px 80px -32px rgba(26, 23, 20, 0.45);
  }
  .code-titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid oklch(0.28 0.01 65);
    font-size: 12px;
    color: oklch(0.65 0.01 80);
  }
  .code-dots {
    display: inline-flex;
    gap: 6px;
  }
  .code-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: oklch(0.35 0.01 65);
    display: block;
  }
  .code-dots i:first-child {
    background: var(--primary);
  }
  .code-host {
    margin-left: auto;
    color: oklch(0.55 0.01 80);
  }
  .code-window pre {
    padding: 24px !important;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
    margin: 0;
    background: transparent !important;
  }

  .api {
    padding: 40px 0 96px;
    text-align: center;
  }
  .api h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    margin: 16px 0 20px;
  }
  .api-body {
    max-width: 62ch;
    margin: 0 auto;
    color: var(--muted-foreground);
    font-size: 17px;
  }
  .endpoint-table {
    margin: 48px auto 0;
    max-width: 860px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
    text-align: left;
  }
  .endpoint-row {
    display: grid;
    grid-template-columns: 64px 1fr 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 14px 20px;
    border-top: 1px solid var(--border);
  }
  .endpoint-row:first-child {
    border-top: none;
  }
  .method {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .method-post {
    color: var(--primary);
  }
  .method-get {
    color: oklch(0.55 0.12 155);
  }
  .method-delete {
    color: var(--muted-foreground);
  }
  .endpoint-path {
    font-size: 13px;
  }
  .endpoint-desc {
    font-size: 14px;
    color: var(--muted-foreground);
  }
  .api-footer {
    margin-top: 24px;
    font-size: 14px;
    color: var(--muted-foreground);
  }

  .pricing {
    padding: 96px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .pricing h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    margin: 16px 0 20px;
  }
  .pricing-sub {
    max-width: 56ch;
    margin: 0 auto;
    color: var(--muted-foreground);
    font-size: 17px;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 960px;
    margin: 48px auto 0;
    text-align: left;
  }
  .tier {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .tier-featured {
    border-color: var(--primary);
    box-shadow: 0 24px 60px -28px rgba(166, 61, 47, 0.35);
  }
  .tier-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .tier-featured .tier-name {
    color: var(--primary);
  }
  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 14px;
  }
  .tier-price .serif {
    font-size: 44px;
    line-height: 1;
  }
  .tier-unit {
    font-size: 12px;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
  }
  .tier-blurb {
    font-size: 14px;
    color: var(--muted-foreground);
    margin-top: 10px;
  }
  .tier-features {
    list-style: none;
    margin: 20px 0 24px;
    display: grid;
    gap: 10px;
    font-size: 14px;
    flex: 1;
  }
  .tier-features li {
    padding-left: 20px;
    position: relative;
  }
  .tier-features li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--primary);
  }
  .tier-cta {
    width: 100%;
  }
  .pricing-note {
    margin-top: 28px;
    font-size: 12px;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
  }

  .developer {
    background: var(--foreground);
    color: oklch(0.982 0.002 90);
    padding: 96px 0;
  }
  .dev-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .developer .eyebrow {
    color: oklch(0.78 0.09 30);
  }
  .dev-copy h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    margin: 16px 0 20px;
  }
  .dev-copy p {
    color: oklch(0.8 0.01 80);
    font-size: 17px;
  }
  .endpoints {
    list-style: none;
    margin-top: 28px;
    display: grid;
    gap: 8px;
    font-size: 13px;
    color: oklch(0.7 0.02 80);
  }
  .endpoints li::before {
    content: "→ ";
    color: var(--brand-400);
  }
  .dev-panel {
    display: flex;
    justify-content: center;
  }
  .mcp-card {
    width: 100%;
    max-width: 440px;
    background: oklch(0.19 0.01 65);
    border: 1px solid oklch(0.28 0.01 65);
    border-radius: var(--radius);
    padding: 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.8;
    display: grid;
    gap: 14px;
  }
  .mcp-row {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: oklch(0.7 0.02 80);
  }
  .mcp-method {
    color: oklch(0.78 0.09 30);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
  .mcp-msg {
    color: oklch(0.85 0.02 80);
  }
  .mcp-ok {
    color: oklch(0.75 0.12 155);
  }

  .comparison {
    padding: 96px 0;
  }
  .comparison h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    text-align: center;
  }
  .comparison-sub {
    text-align: center;
    color: var(--muted-foreground);
    margin-top: 12px;
  }
  .compare-table {
    margin: 56px auto 0;
    max-width: 860px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }
  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .compare-head {
    background: var(--secondary);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .compare-head span,
  .compare-row span {
    padding: 16px 24px;
  }
  .compare-row {
    border-top: 1px solid var(--border);
    font-size: 15px;
  }
  .compare-row .them {
    color: var(--muted-foreground);
    border-right: 1px solid var(--border);
  }
  .compare-row .seal {
    font-weight: 500;
  }
  .compare-head span:first-child {
    border-right: 1px solid var(--border);
  }

  .final-cta {
    padding: 96px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .final-inner h2 {
    font-size: clamp(36px, 5vw, 56px);
    margin: 24px 0 12px;
  }
  .final-inner > p {
    color: var(--muted-foreground);
    font-size: 17px;
  }
  .final-inner .btn-lg {
    margin-top: 32px;
  }
  .final-note {
    margin-top: 20px;
    font-size: 12px;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 32px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }
  .footer-brand p {
    color: var(--muted-foreground);
    font-size: 14px;
    margin-top: 8px;
    max-width: 28ch;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .footer-col h4 {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 14px;
  }
  .footer-col a {
    display: block;
    font-size: 14px;
    color: var(--muted-foreground);
    padding: 4px 0;
  }
  .footer-col a:hover {
    color: var(--foreground);
  }
  .footer-legal {
    margin-top: 56px;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
    .dev-inner,
    .tiers {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .dev-inner {
      gap: 40px;
    }
    .endpoint-row {
      grid-template-columns: 56px 1fr;
    }
    .endpoint-desc {
      grid-column: 2;
    }
    .compare-head,
    .compare-row {
      grid-template-columns: 1fr;
    }
    .compare-row .them {
      border-right: none;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 8px;
    }
    .compare-row .seal {
      padding-top: 8px;
    }
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero {
      padding: 72px 0 64px;
    }
  }
</style>
