---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import { landing } from "../data/landing";

// Static page — render at build so every landing hit is an asset serve,
// not a worker invocation (and Shiki runs at build, not in the worker).
export const prerender = true;
---

<Base title={landing.title} description={landing.description}>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="logo" aria-label="Seal home">
        <svg viewBox="0 0 200 200" width="26" height="26" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M50 154 C58 108 88 62 152 40 C146 90 116 136 62 146 Z" stroke-width="9"/>
          <path d="M42 166 C84 124 120 78 152 40" stroke-width="6"/>
          <path d="M74 130 C84 127 92 122 98 114" stroke-width="5"/>
          <path d="M104 92 C114 89 122 84 128 76" stroke-width="5"/>
        </svg>
        <span class="logo-word">Seal</span>
      </a>
      <div class="nav-links">
        {landing.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="nav-actions">
        <a class="nav-signin" href={landing.nav.signIn.href}>{landing.nav.signIn.label}</a>
        <a class="btn btn-ink" href={landing.nav.cta.href}>{landing.nav.cta.label}</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-mark" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M50 154 C58 108 88 62 152 40 C146 90 116 136 62 146 Z" stroke-width="9"/>
        <path d="M42 166 C84 124 120 78 152 40" stroke-width="6"/>
        <path d="M74 130 C84 127 92 122 98 114" stroke-width="5"/>
        <path d="M104 92 C114 89 122 84 128 76" stroke-width="5"/>
      </svg>
    </div>
    <div class="container">
      <p class="eyebrow">{landing.hero.eyebrow}</p>
      <h1>{landing.hero.headline}</h1>
      <p class="sub">{landing.hero.subheadline}</p>
      <div class="hero-ctas">
        <a class="btn btn-ink btn-lg" href={landing.hero.primaryCta.href}>{landing.hero.primaryCta.label}</a>
        <a class="btn btn-line btn-lg" href={landing.hero.secondaryCta.href}>{landing.hero.secondaryCta.label}</a>
      </div>

      <div class="install" role="group" aria-label="Install Seal">
        <div class="install-tabs">
          {landing.hero.installTabs.map((t, i) => (
            <button class={`mono install-tab ${i === 0 ? "active" : ""}`} data-install={i} type="button">
              {t.label}
            </button>
          ))}
        </div>
        <div class="install-cmd">
          <span class="mono install-prompt" aria-hidden="true">$</span>
          <code class="mono" id="install-command">{landing.hero.installTabs[0].command}</code>
        </div>
      </div>

      <div class="code-window">
        <div class="code-titlebar">
          <span class="mono">{landing.hero.codeFile}</span>
          <span class="mono code-host">api.seal.nyc</span>
        </div>
        <Code code={landing.hero.codeSnippet} lang="ts" theme="github-dark-default" />
      </div>
    </div>
  </header>

  <section id="api" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{landing.api.eyebrow}</p>
        <span class="mono section-index">( {landing.api.index} )</span>
      </div>
      <h2>{landing.api.title}</h2>
      <p class="section-body">{landing.api.body}</p>
      <div class="endpoint-table">
        {
          landing.api.endpoints.map((e) => (
            <div class="endpoint-row">
              <span class={`mono method method-${e.method.toLowerCase()}`}>{e.method}</span>
              <span class="mono endpoint-path">{e.path}</span>
              <span class="endpoint-desc">{e.desc}</span>
            </div>
          ))
        }
      </div>
      <p class="section-footer mono">{landing.api.footer}</p>
    </div>
  </section>

  <section class="section manifesto">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{landing.manifesto.eyebrow}</p>
        <span class="mono section-index">( {landing.manifesto.index} )</span>
      </div>
      <h2>{landing.manifesto.title}</h2>
      <p class="dict serif">
        <span class="dict-term">{landing.manifesto.definition.term}</span>
        <span class="mono dict-phonetic">{landing.manifesto.definition.phonetic}</span>
        <span class="mono dict-pos">{landing.manifesto.definition.pos}</span>
        <em class="dict-gloss">{landing.manifesto.definition.gloss}</em>
      </p>
      <div class="manifesto-lines">
        {landing.manifesto.lines.map((line) => <p class="serif">{line}</p>)}
      </div>
    </div>
  </section>

  <section id="pricing" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{landing.pricing.eyebrow}</p>
        <span class="mono section-index">( {landing.pricing.index} )</span>
      </div>
      <h2>{landing.pricing.title}</h2>
      <p class="section-body">{landing.pricing.subtitle}</p>
      <div class="tiers">
        {
          landing.pricing.tiers.map((t) => (
            <div class={`tier ${t.featured ? "tier-featured" : ""}`}>
              <h3 class="mono tier-name">{t.name}</h3>
              <div class="tier-price">
                <span class="tier-amount">{t.price}</span>
                <span class="mono tier-unit">{t.unit}</span>
              </div>
              <p class="tier-blurb">{t.blurb}</p>
              <ul class="tier-features">
                {t.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a class={t.featured ? "btn btn-ink tier-cta" : "btn btn-line tier-cta"} href={t.cta.href}>
                {t.cta.label}
              </a>
            </div>
          ))
        }
      </div>
      <p class="section-footer mono">{landing.pricing.note}</p>
    </div>
  </section>

  <section class="developer">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow-dark">{landing.developer.eyebrow}</p>
        <span class="mono section-index section-index-dark">( {landing.developer.index} )</span>
      </div>
      <div class="dev-grid">
        <div>
          <h2 class="dev-title">{landing.developer.title}</h2>
          <p class="dev-body">{landing.developer.body}</p>
        </div>
        <ul class="dev-points">
          {landing.developer.points.map((p) => <li class="mono">{p}</li>)}
        </ul>
      </div>
      <p class="dev-clients mono">{landing.developer.clients}</p>
    </div>
  </section>

  <section class="section comparison">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The alternative</p>
      </div>
      <h2>{landing.comparison.title}</h2>
      <p class="section-body">{landing.comparison.subtitle}</p>
      <div class="compare-table">
        <div class="compare-head">
          <span class="mono">Them</span>
          <span class="mono">Seal</span>
        </div>
        {
          landing.comparison.rows.map((r) => (
            <div class="compare-row">
              <span class="them">{r.them}</span>
              <span class="seal">{r.seal}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-inner">
      <svg class="final-mark" viewBox="0 0 200 200" width="72" height="72" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M50 154 C58 108 88 62 152 40 C146 90 116 136 62 146 Z" stroke-width="9"/>
        <path d="M42 166 C84 124 120 78 152 40" stroke-width="6"/>
        <path d="M74 130 C84 127 92 122 98 114" stroke-width="5"/>
        <path d="M104 92 C114 89 122 84 128 76" stroke-width="5"/>
      </svg>
      <h2>{landing.finalCta.headline}</h2>
      <p>{landing.finalCta.sub}</p>
      <a class="btn btn-ink btn-lg" href={landing.finalCta.cta.href}>{landing.finalCta.cta.label}</a>
      <p class="final-note mono">{landing.finalCta.note}</p>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="logo footer-logo">
          <svg viewBox="0 0 200 200" width="30" height="30" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M50 154 C58 108 88 62 152 40 C146 90 116 136 62 146 Z" stroke-width="9"/>
            <path d="M42 166 C84 124 120 78 152 40" stroke-width="6"/>
            <path d="M74 130 C84 127 92 122 98 114" stroke-width="5"/>
            <path d="M104 92 C114 89 122 84 128 76" stroke-width="5"/>
          </svg>
          <span class="logo-word">Seal</span>
        </span>
        <p>{landing.footer.tagline}</p>
      </div>
      <div class="footer-cols">
        {
          landing.footer.columns.map((col) => (
            <div class="footer-col">
              <h4 class="mono">{col.title}</h4>
              {col.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="container footer-legal">
      <span class="mono">© 2026 Seal · New York City</span>
    </div>
  </footer>
</Base>

<script define:vars={{ commands: landing.hero.installTabs.map((t) => t.command) }}>
  const tabs = document.querySelectorAll(".install-tab");
  const cmd = document.getElementById("install-command");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      const i = Number(tab.getAttribute("data-install"));
      if (cmd) cmd.textContent = commands[i];
    });
  });
</script>

<style>
  /* ————— spec-sheet system ————— */

  .container {
    max-width: 1120px;
  }

  .eyebrow {
    color: var(--foreground);
  }

  .section {
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-top: 1px solid var(--foreground);
    padding-top: 14px;
    margin-bottom: 56px;
    position: relative;
  }

  .section-head::before,
  .section-head::after {
    content: "+";
    position: absolute;
    top: -7px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted-foreground);
  }
  .section-head::before { left: -6px; }
  .section-head::after { right: -5px; }

  .section-index {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted-foreground);
  }

  h1,
  h2,
  .tier-amount {
    font-family: var(--font-serif);
    font-weight: 400;
  }

  h2 {
    font-size: clamp(34px, 4.5vw, 52px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    max-width: 22ch;
  }

  .section-body {
    max-width: 56ch;
    margin-top: 20px;
    color: var(--muted-foreground);
    font-size: 17px;
  }

  .section-footer {
    margin-top: 28px;
    font-size: 12px;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
  }

  /* ————— hero ————— */

  .hero {
    padding: 120px 0 100px;
    position: relative;
    overflow: hidden;
  }
  .hero-mark {
    position: absolute;
    top: -14%;
    right: -8%;
    width: min(760px, 56vw);
    color: var(--primary);
    opacity: 0.055;
    transform: rotate(10deg);
    pointer-events: none;
  }
  .hero-mark svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .hero .container {
    position: relative;
    z-index: 1;
  }
  .hero h1 {
    font-size: clamp(52px, 8.5vw, 104px);
    letter-spacing: -0.025em;
    line-height: 1.0;
    margin-top: 32px;
  }
  .hero .sub {
    max-width: 52ch;
    margin-top: 32px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted-foreground);
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    margin-top: 44px;
    flex-wrap: wrap;
  }

  /* ————— install tabs ————— */

  .install {
    margin-top: 56px;
    max-width: 720px;
    border: 1px solid var(--border);
  }
  .install-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .install-tab {
    padding: 10px 18px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    background: none;
    border: none;
    border-right: 1px solid var(--border);
    cursor: pointer;
    white-space: nowrap;
  }
  .install-tab:hover {
    color: var(--foreground);
  }
  .install-tab.active {
    color: var(--foreground);
    background: var(--secondary);
    box-shadow: inset 0 -2px 0 var(--primary);
  }
  .install-cmd {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    font-size: 13px;
    overflow-x: auto;
  }
  .install-prompt {
    color: var(--primary);
    font-weight: 700;
  }

  /* ————— code window ————— */

  .code-window {
    margin-top: 24px;
    max-width: 720px;
    text-align: left;
    border: 1px solid oklch(0.28 0.01 65);
    background: oklch(0.17 0.012 65);
  }
  .code-titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid oklch(0.28 0.01 65);
    font-size: 12px;
    color: oklch(0.65 0.01 80);
  }
  .code-host {
    margin-left: auto;
    color: oklch(0.5 0.01 80);
  }
  .code-window pre {
    padding: 24px !important;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
    margin: 0;
    background: transparent !important;
  }

  /* ————— endpoint table ————— */

  .endpoint-table {
    margin-top: 48px;
    border-top: 1px solid var(--foreground);
    text-align: left;
  }
  .endpoint-row {
    display: grid;
    grid-template-columns: 72px 1fr 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
  }
  .method {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .method-post {
    color: var(--primary);
  }
  .method-get {
    color: var(--muted-foreground);
  }
  .method-delete {
    color: var(--muted-foreground);
  }
  .endpoint-path {
    font-size: 13px;
  }
  .endpoint-desc {
    font-size: 14px;
    color: var(--muted-foreground);
  }

  /* ————— manifesto ————— */

  .dict {
    margin-top: 40px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: clamp(18px, 2.2vw, 24px);
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .dict-term {
    color: var(--primary);
    font-size: 1.3em;
  }
  .dict-phonetic {
    color: var(--muted-foreground);
    font-size: 0.7em;
    letter-spacing: 0.02em;
  }
  .dict-pos {
    color: var(--primary);
    font-size: 0.7em;
  }
  .dict-gloss {
    color: var(--muted-foreground);
    font-size: 0.85em;
  }

  .manifesto-lines {
    margin-top: 56px;
    display: grid;
    gap: 40px;
    max-width: 760px;
  }
  .manifesto-lines p {
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .manifesto-lines p:last-child {
    color: var(--primary);
    font-style: italic;
  }

  /* ————— pricing ————— */

  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 56px;
    border-top: 1px solid var(--foreground);
  }
  .tier {
    padding: 28px 28px 32px;
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }
  .tier:first-child {
    border-left: 1px solid var(--border);
  }
  .tier-featured {
    border-left: 1px solid var(--border);
    box-shadow: inset 0 3px 0 var(--primary);
  }
  .tier-name {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .tier-featured .tier-name {
    color: var(--primary);
  }
  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 18px;
  }
  .tier-amount {
    font-size: 40px;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .tier-unit {
    font-size: 11px;
    color: var(--muted-foreground);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tier-blurb {
    font-size: 14px;
    color: var(--muted-foreground);
    margin-top: 12px;
  }
  .tier-features {
    list-style: none;
    margin: 22px 0 28px;
    display: grid;
    gap: 10px;
    font-size: 14px;
    flex: 1;
  }
  .tier-features li {
    padding-left: 18px;
    position: relative;
  }
  .tier-features li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--primary);
  }
  .tier-cta {
    width: 100%;
  }

  /* ————— developer / dark band ————— */

  .developer {
    background: var(--foreground);
    color: var(--background);
    padding: 96px 0;
  }
  .developer .section-head {
    border-top-color: oklch(0.45 0.01 65);
  }
  .eyebrow-dark {
    color: oklch(0.78 0.01 80);
  }
  .section-index-dark {
    color: oklch(0.55 0.01 80);
  }
  .dev-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 72px;
    align-items: start;
  }
  .dev-title {
    color: var(--background);
  }
  .dev-body {
    margin-top: 20px;
    color: oklch(0.75 0.01 80);
    font-size: 17px;
    max-width: 48ch;
  }
  .dev-points {
    list-style: none;
    display: grid;
    font-size: 13px;
    border-top: 1px solid oklch(0.45 0.01 65);
  }
  .dev-points li {
    padding: 16px 0;
    border-bottom: 1px solid oklch(0.3 0.01 65);
    color: oklch(0.72 0.01 80);
  }
  .dev-points li::before {
    content: "→ ";
    color: oklch(0.78 0.01 80);
  }
  .dev-clients {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid oklch(0.3 0.01 65);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: oklch(0.6 0.01 80);
  }

  /* ————— comparison ————— */

  .compare-table {
    margin-top: 48px;
    border-top: 1px solid var(--foreground);
  }
  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .compare-head {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    border-bottom: 1px solid var(--border);
  }
  .compare-head span,
  .compare-row span {
    padding: 16px 0;
  }
  .compare-head span:first-child,
  .compare-row span:first-child {
    padding-right: 32px;
  }
  .compare-head span:last-child,
  .compare-row span:last-child {
    padding-left: 32px;
    border-left: 1px solid var(--border);
  }
  .compare-row {
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .compare-row .them {
    color: var(--muted-foreground);
  }
  .compare-row .seal {
    font-weight: 500;
  }

  /* ————— final cta + footer ————— */

  .final-cta {
    padding: 120px 0;
    border-top: 1px solid var(--border);
  }
  .final-mark {
    color: var(--primary);
    margin-bottom: 28px;
  }
  .final-inner h2 {
    font-size: clamp(48px, 7vw, 88px);
    letter-spacing: -0.025em;
    max-width: none;
  }
  .final-inner > p {
    color: var(--muted-foreground);
    font-size: 17px;
    margin-top: 16px;
  }
  .final-inner .btn-lg {
    margin-top: 40px;
  }
  .final-note {
    margin-top: 24px;
    font-size: 12px;
    color: var(--muted-foreground);
    letter-spacing: 0.06em;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 32px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }
  .footer-brand p {
    color: var(--muted-foreground);
    font-size: 14px;
    margin-top: 8px;
    max-width: 28ch;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .footer-col h4 {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 14px;
    font-weight: 600;
  }
  .footer-col a {
    display: block;
    font-size: 14px;
    color: var(--muted-foreground);
    padding: 4px 0;
  }
  .footer-col a:hover {
    color: var(--foreground);
  }
  .footer-legal {
    margin-top: 56px;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  /* ————— responsive ————— */

