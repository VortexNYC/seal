{
  "extends": "@seal/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ES2022", "WebWorker", "DOM"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist"]
}
