# Landing App Environment Variables
# Copy this file to .env.local and fill in your values.

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Found at: https://dashboard.clerk.com → your app → API Keys
# Used to show the sign-in/sign-up buttons on the marketing site
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────────
# URL of the product web app — used for cross-app links (e.g. "Go to app" CTAs)
VITE_APP_URL=http://localhost:5173

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Found at: https://posthog.com → your project → Project Settings → Project API Key
# VITE_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
