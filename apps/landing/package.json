{
  "name": "@seal/landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "content:generate": "bunx fumadocs-mdx source.config.ts .source",
    "content:manifest": "bunx vite-node ./tools/generate-docs-manifest.ts",
    "content:prepare": "bun run content:generate && bun run content:manifest",
    "docs:generate:api": "bun run tools/generate-api-docs.ts",
    "content:search": "bunx vite-node ./tools/generate-search-index.ts",
    "content:sitemap": "bunx vite-node ./tools/generate-sitemap.ts",
    "build:app": "vite build",
    "build": "bun run content:prepare && bun run content:search && bun run content:sitemap && bun run build:app",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "pretypecheck": "bun run content:prepare",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/client": "^7.15.0",
    "@sanity/image-url": "^2.0.3",
    "@scalar/api-reference-react": "^0.8.67",
    "@seal/sanity-config": "workspace:*",
    "@seal/tokens": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-router": "^1.157.18",
    "@tanstack/react-start": "^1.157.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.4.9",
    "fumadocs-openapi": "^10.3.14",
    "fumadocs-ui": "^16.4.9",
    "lucide-react": "^0.563.0",
    "motion": "^12.34.3",
    "nitro": "^3.0.1-alpha.2",
    "path-browserify": "^1.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "fumadocs-mdx": "^14.2.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
