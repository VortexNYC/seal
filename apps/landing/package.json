{
  "name": "@seal/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "content:generate": "bunx fumadocs-mdx source.config.ts .source",
    "content:manifest": "VITE_SEAL_CONTENT_TOOL=1 vite-node ./tools/generate-content-manifests.ts",
    "content:prepare": "bun run content:generate && bun run content:manifest",
    "docs:generate:api": "bun run tools/generate-api-docs.ts",
    "content:search": "VITE_SEAL_CONTENT_TOOL=1 vite-node ./tools/generate-search-index.ts",
    "content:sitemap": "VITE_SEAL_CONTENT_TOOL=1 vite-node ./tools/generate-sitemap.ts",
    "build:app": "vite build",
    "build": "bun run content:prepare && bun run content:search && bun run content:sitemap && bun run build:app",
    "postbuild": "bun run tools/copy-server-runtime-deps.ts",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "pretypecheck": "bun run content:prepare",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:5181",
    "react:doctor": "vortex-react-doctor --diff",
    "react:doctor:full": "vortex-react-doctor --full --advisory"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@seal/tokens": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-start": "^1.167.16",
    "@tanstack/router-core": "1.168.9",
    "@vortexnyc/observability": "0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.7.10",
    "fumadocs-openapi": "^10.6.6",
    "fumadocs-ui": "^16.7.10",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "nitro": "^3.0.260311-beta",
    "path-browserify": "^1.0.1",
    "posthog-js": "^1.335.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.2",
    "fumadocs-mdx": "^14.2.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:"
  }
}
