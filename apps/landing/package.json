{
  "name": "@seal/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "content:generate": "bunx fumadocs-mdx source.config.ts .source",
    "content:manifest": "bunx vite-node ./tools/generate-content-manifests.ts",
    "content:prepare": "bun run content:generate && bun run content:manifest",
    "docs:generate:api": "bun run tools/generate-api-docs.ts",
    "content:search": "bunx vite-node ./tools/generate-search-index.ts",
    "content:sitemap": "bunx vite-node ./tools/generate-sitemap.ts",
    "build:app": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build": "bun run content:prepare && bun run content:search && bun run content:sitemap && bun run build:app",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "pretypecheck": "bun run content:prepare",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3001"
  },
  "dependencies": {
    "@clerk/clerk-react": "catalog:",
    "@radix-ui/react-accordion": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@scalar/api-reference-react": "^0.9.13",
    "@seal/tokens": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "^1.167.1",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "fumadocs-core": "^16.7.2",
    "fumadocs-openapi": "^10.4.1",
    "fumadocs-ui": "^16.7.2",
    "lucide-react": "catalog:",
    "motion": "^12.38.0",
    "nitro": "^3.0.260311-beta",
    "path-browserify": "^1.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "fumadocs-mdx": "^14.2.11",
    "tslib": "^2.8.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
