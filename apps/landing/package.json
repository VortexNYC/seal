{
  "name": "@seal/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "content:generate": "bunx fumadocs-mdx source.config.ts .source",
    "content:manifest": "bunx vite-node ./tools/generate-content-manifests.ts",
    "content:prepare": "bun run content:generate && bun run content:manifest",
    "docs:generate:api": "bun run tools/generate-api-docs.ts",
    "content:search": "bunx vite-node ./tools/generate-search-index.ts",
    "content:sitemap": "bunx vite-node ./tools/generate-sitemap.ts",
    "build:app": "node --max-old-space-size=6144 ../../node_modules/vite/bin/vite.js build",
    "build": "bun run content:prepare && bun run content:search && bun run content:sitemap && bun run build:app",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "pretypecheck": "bun run content:prepare",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3001"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@scalar/api-reference-react": "^0.9.19",
    "@seal/tokens": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-start": "^1.167.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.7.10",
    "fumadocs-openapi": "^10.6.5",
    "fumadocs-ui": "^16.7.10",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "nitro": "^3.0.260311-beta",
    "path-browserify": "^1.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.2",
    "fumadocs-mdx": "^14.2.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
