{
  "name": "@seal/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "content:generate": "pnpm exec fumadocs-mdx source.config.ts .source",
    "content:manifest": "VITE_SEAL_CONTENT_TOOL=1 pnpm exec tsx tools/run-content-tool.ts tools/generate-content-manifests.ts",
    "content:prepare": "pnpm run content:generate && pnpm run content:manifest",
    "docs:generate:api": "pnpm exec tsx tools/generate-api-docs.ts",
    "content:search": "VITE_SEAL_CONTENT_TOOL=1 pnpm exec tsx tools/run-content-tool.ts tools/generate-search-index.ts",
    "content:sitemap": "VITE_SEAL_CONTENT_TOOL=1 pnpm exec tsx tools/run-content-tool.ts tools/generate-sitemap.ts",
    "build:app": "vite build",
    "build": "pnpm run content:prepare && pnpm run content:search && pnpm run content:sitemap && pnpm run build:app",
    "postbuild": "pnpm exec tsx tools/copy-server-runtime-deps.ts",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "pretypecheck": "pnpm run content:prepare",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:5181",
    "react:doctor": "vortex-react-doctor --diff",
    "react:doctor:full": "vortex-react-doctor --full --advisory",
    "deploy": "pnpm run build && wrangler deploy",
    "cf:types:mkdir": "node -e \"require('node:fs').mkdirSync('.wrangler/types', { recursive: true })\"",
    "cf:types": "pnpm run cf:types:mkdir && wrangler types .wrangler/types/cloudflare-env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@seal/tokens": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-router": "1.170.19",
    "@tanstack/react-start": "^1.167.16",
    "@tanstack/router-core": "1.171.16",
    "@vortexnyc/observability": "0.2.0",
    "@vortexnyc/ui": "0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.14.1",
    "fumadocs-openapi": "^11.2.3",
    "fumadocs-ui": "^16.14.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "nitro": "^3.0.260311-beta",
    "path-browserify": "^1.0.1",
    "posthog-js": "^1.335.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.2",
    "fumadocs-mdx": "^14.2.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "^4.100.0"
  }
}
