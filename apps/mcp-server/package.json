{
  "name": "@seal/mcp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "pnpm run dev:http",
    "dev:http": "bun --watch --no-clear-screen src/index.ts",
    "dev:stdio": "pnpm src/index.ts --stdio",
    "test": "pnpm test",
    "test:watch": "pnpm test --watch",
    "build": "pnpm build src/index.ts --outdir=dist --target=node --format=esm",
    "start": "node dist/index.js",
    "lint": "vp lint && pnpm run lint:convex",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "pnpm dlx tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "clean": "git clean -xdf .cache .turbo node_modules dist"
  },
  "dependencies": {
    "@clerk/express": "^1.3.30",
    "@clerk/mcp-tools": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@seal/backend": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@vercel/node": "^5.5.18",
    "typescript": "catalog:"
  }
}
