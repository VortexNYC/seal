{
	"name": "@seal/mcp-server",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"scripts": {
		"dev": "bun run dev:http",
		"dev:http": "bun --watch --no-clear-screen src/index.ts",
		"dev:stdio": "bun src/index.ts --stdio",
		"build": "bun build src/index.ts --outdir=dist --target=node --format=esm",
		"start": "node dist/index.js",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "bun --bun x tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"knip": "knip --directory ../.. --workspace apps/mcp-server",
		"clean": "git clean -xdf .cache .tanstack .turbo node_modules dist"
	},
	"dependencies": {
		"@clerk/express": "^1.3.30",
		"@clerk/mcp-tools": "^0.3.1",
		"@modelcontextprotocol/sdk": "^1.12.0",
		"@seal/backend": "workspace:*",
		"cors": "^2.8.5",
		"express": "^4.21.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@vercel/node": "^5.5.18",
		"knip": "catalog:",
		"typescript": "catalog:"
	}
}
