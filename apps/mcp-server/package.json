{
	"name": "@seal/mcp-server",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"scripts": {
		"dev": "bun run dev:http",
		"dev:http": "bun --watch --no-clear-screen src/index.ts",
		"dev:stdio": "bun src/index.ts --stdio",
		"build": "bun build src/index.ts --outdir=dist --target=node --format=esm",
		"start": "node dist/index.js",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "bun --bun x tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"knip": "knip --directory ../.. --workspace apps/mcp-server",
		"clean": "git clean -xdf .cache .turbo node_modules dist"
	},
	"dependencies": {
		"@clerk/backend": "^1.27.0",
		"@hono/clerk-auth": "^2.0.0",
		"@modelcontextprotocol/sdk": "^1.12.0",
		"@seal/backend": "workspace:*",
		"hono": "^4.7.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@types/bun": "^1.2.6",
		"@vercel/node": "^5.5.18",
		"knip": "^5.78.0",
		"typescript": "^5.9.3"
	}
}
