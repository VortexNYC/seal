# MCP Server Environment Variables
# Copy this file to .env.local and fill in your values.

# ── Seal API ──────────────────────────────────────────────────────────────────
# API key for server-to-server auth (fallback when no user token is provided).
# Obtain from: Seal app → your organization → Settings → API Keys
SEAL_API_KEY=your-seal-api-key

# Base URL for the Seal API (default: https://seal.convex.site/api/v1)
# Override for local development: http://localhost:3000/api/v1
# SEAL_API_BASE_URL=https://seal.convex.site/api/v1

# ── Transport ─────────────────────────────────────────────────────────────────
# Transport mode: "stdio" (for local AI clients) or "http" (for hosted/remote)
# Defaults to "http" unless VERCEL=1 or MCP_TRANSPORT=stdio
# MCP_TRANSPORT=stdio

# HTTP server port (default: 5183)
# PORT=5183

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: "debug" | "info" | "warn" | "error" (default: info)
# SEAL_LOG_LEVEL=info

# Log format: "json" (for structured log pipelines) | "pretty" (default)
# SEAL_LOG_FORMAT=pretty

# ── Advanced ──────────────────────────────────────────────────────────────────
# Enable verbose debug logging (default: false)
# SEAL_DEBUG=false

# Max file upload size in bytes (default: 52428800 = 50 MB)
# SEAL_MAX_FILE_SIZE=52428800

# Request timeout in milliseconds (default: 30000 = 30 s)
# SEAL_REQUEST_TIMEOUT=30000
