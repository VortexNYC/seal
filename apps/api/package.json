{
  "name": "@seal/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy -e production",
    "deploy:selfhost": "bash ../../scripts/selfhost-deploy-api.sh",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Session signing secret. Generate with `openssl rand -base64 32` (≥32 chars)."
      },
      "TOKEN_HASH_SECRET": {
        "description": "API token hashing secret. Generate with `openssl rand -base64 32`."
      },
      "INTERNAL_API_KEY": {
        "description": "Shared key for Worker-to-Worker `/internal` calls. Generate with `openssl rand -base64 32`."
      },
      "MCP_SIGNING_KEY": {
        "description": "Optional. Only needed if you deploy the MCP worker."
      },
      "SEAL_SEALING_P12": {
        "description": "Optional. Base64 PKCS#12 for platform PAdES-B (SEA-49 L1b). Generate offline; never commit."
      },
      "SEAL_SEALING_P12_PASSPHRASE": {
        "description": "Optional. Passphrase for SEAL_SEALING_P12."
      },
      "D1": {
        "description": "Primary Seal database (auto-provisioned on first selfhost deploy)."
      },
      "DOCUMENTS_BUCKET": {
        "description": "R2 bucket for PDFs and signed artifacts (auto-provisioned)."
      }
    }
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.10",
    "@orama/orama": "^3.1.18",
    "@seal/internal-auth": "workspace:*",
    "@seal/transactional": "workspace:*",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "@signpdf/utils": "3.3.0",
    "@vortex-api/better-auth-ui": "0.2.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "6.9.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@seal/tsconfig": "workspace:*",
    "@types/node-forge": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.133.0"
  }
}
