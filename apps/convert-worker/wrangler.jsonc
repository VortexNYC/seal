{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seal-convert-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "containers": [
    {
      "class_name": "Converter",
      "image": "docker.io/gotenberg/gotenberg:8@sha256:3fdee07e0dcd5005c3db4d81d1600d081fc6fb424da87e409e1c1f9624a249b8",
      "max_instances": 5,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERTER",
        "class_name": "Converter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Converter"],
    },
  ],
}
