# Web App Environment Variables
# Copy this file to .env.local and fill in your values.

# ── API ─────────────────────────────────────────────────────────────────────────
# Base URL of the Seal API (apps/api)
VITE_API_URL=http://localhost:8787

# Base URL of the Better Auth server (apps/api serves /api/auth/*)
VITE_BETTER_AUTH_URL=http://localhost:8787

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of this app (used for deep links and OG metadata)
VITE_APP_URL=http://localhost:5173

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Found at: https://posthog.com → your project → Project Settings → Project API Key
# VITE_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Error Tracking (optional) ─────────────────────────────────────────────────
# Found at: https://sentry.io → your project → Settings → Client Keys (DSN)
# VITE_SENTRY_DSN=https://your_key@sentry.io/project_id
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=

# ── Jam.dev Bug Reporting (optional) ─────────────────────────────────────────
# Found at: https://jam.dev → your team → Settings
# VITE_JAM_TEAM_ID=your-team-id
