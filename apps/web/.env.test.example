# Test Environment Variables
# Copy this file to .env.test and fill in the values

# Test user credentials for E2E tests
E2E_TEST_USER_EMAIL=seal-e2e@seal.nyc
E2E_TEST_USER_PASSWORD=SealE2ePassword123!
E2E_TEST_EMAIL_CODE=424242
# Optional stable workspace overrides used by setup/global auth recovery
# E2E_TEST_ORGANIZATION_NAME=Seal E2E Workspace
# E2E_TEST_ORGANIZATION_SLUG=seal-e2e-test

# Seal API base URL used by E2E fixtures
VITE_API_URL=http://localhost:8787
VITE_BETTER_AUTH_URL=http://localhost:8787
VITE_APP_URL=http://localhost:5180

# PostHog (optional in test, omit to disable)
# VITE_PUBLIC_POSTHOG_KEY=phc_your_key_here

# Sentry (optional in test, omit to disable)
# VITE_SENTRY_DSN=https://your_dsn@sentry.io/project_id

# Jam.dev (optional in test, omit to disable)
# VITE_JAM_TEAM_ID=your_team_id

# Playwright configuration
PLAYWRIGHT_BASE_URL=http://localhost:5180

# Chrome DevTools MCP
CHROME_DEVTOOLS_PORT=9222
