{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seal-web-dev",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ingest/*"],
  },
  "env": {
    "production": {
      "name": "seal-web",
      "preview_urls": true,
      "routes": [
        {
          "pattern": "app.seal.nyc",
          "custom_domain": true,
        },
      ],
    },
    // Self-host on your account — workers.dev, no Vortex custom domain.
    // Distinct name from production seal-web so Vortex-account mistakes are safe.
    "selfhost": {
      "name": "seal-selfhost-web",
      "workers_dev": true,
      "preview_urls": true,
    },
  },
}
