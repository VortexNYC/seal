{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seal-web",
  "compatibility_date": "2026-08-06",
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "app.seal.nyc",
      "custom_domain": true,
    },
    {
      "pattern": "sign.app.vortex.nyc",
      "custom_domain": true,
    },
  ],
}
