{
  "name": "@seal/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "CLOUDFLARE_ENV=production vite build",
    "serve": "vite preview",
    "preview": "vite preview",
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "knip": "pnpm -w exec knip -W @seal/web",
    "knip:fix": "pnpm -w exec knip -W @seal/web --fix --allow-remove-files",
    "clean": "git clean -xdf .cache .tanstack node_modules dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:5180",
    "deploy": "vp run build && vp exec wrangler deploy -e production",
    "react:doctor": "vortex-react-doctor --diff",
    "react:doctor:full": "vortex-react-doctor --full --advisory",
    "cf:types:mkdir": "node -e \"require('node:fs').mkdirSync('.wrangler/types', { recursive: true })\"",
    "cf:types": "pnpm run cf:types:mkdir && wrangler types .wrangler/types/cloudflare-env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.13.2",
    "@hookform/resolvers": "^5.9.1",
    "@jam.dev/sdk": "^0.0.6",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-input/number-format": "^2.0.3",
    "@seal/tokens": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-plugin": "1.168.38",
    "@vortexnyc/better-auth-ui": "0.1.3",
    "better-auth": "1.7.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "konva": "^10.5.0",
    "lucide-react": "^0.563.0",
    "pdfjs-dist": "5.4.296",
    "posthog-js": "^1.433.5",
    "react": "catalog:",
    "react-day-picker": "^9.14.0",
    "react-dom": "catalog:",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.88.0",
    "react-konva": "^19.3.0",
    "react-pdf": "^10.5.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "1.59.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.14.5",
    "jsdom": "29.0.1",
    "react-grab": "^0.1.50",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-dom": "^0.1.1",
    "wrangler": "^4.133.0"
  }
}
