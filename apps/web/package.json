{
  "name": "@seal/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "preview": "vite preview",
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "clean": "git clean -xdf .cache .tanstack node_modules dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:5180",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:staging": "VITE_APP_URL=https://staging-app.seal.nyc VITE_BETTER_AUTH_URL=https://api.seal.nyc pnpm run build && wrangler deploy --name seal-web-staging --domain staging-app.seal.nyc",
    "react:doctor": "vortex-react-doctor --diff",
    "react:doctor:full": "vortex-react-doctor --full --advisory",
    "cf:types:mkdir": "node -e \"require('node:fs').mkdirSync('.wrangler/types', { recursive: true })\"",
    "cf:types": "pnpm run cf:types:mkdir && wrangler types .wrangler/types/cloudflare-env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.100",
    "@cloudflare/ai-chat": "0.11.0",
    "@cloudflare/kumo": "2.13.2",
    "@hookform/resolvers": "^5.2.2",
    "@jam.dev/sdk": "^0.0.6",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-input/number-format": "^2.0.3",
    "@seal/tokens": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "1.170.19",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@tanstack/router-plugin": "1.168.24",
    "@vortex-api/better-auth-ui": "^0.1.3",
    "agents": "0.20.1",
    "ai": "^7.0.97",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "konva": "^10.2.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "5.4.296",
    "posthog-js": "^1.335.0",
    "radix-ui": "^1.4.3",
    "react": "catalog:",
    "react-day-picker": "^9.13.0",
    "react-dom": "catalog:",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.2",
    "react-konva": "^19.2.1",
    "react-pdf": "^10.3.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
