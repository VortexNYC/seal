{
  "name": "@seal/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "preview": "vite preview",
    "lint": "oxlint -c ../../.oxlintrc.json -A eslint/complexity -A eslint/max-lines-per-function",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "bunx tsc -p tsconfig.typecheck.json --noEmit",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "clean": "git clean -xdf .cache .tanstack .turbo node_modules dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:5180",
    "deploy": "bun run build && wrangler deploy",
    "deploy:staging": "VITE_APP_URL=https://staging-app.seal.nyc VITE_CONVEX_URL=https://clever-goose-484.convex.cloud VITE_BETTER_AUTH_URL=https://clever-goose-484.convex.site/api/auth bun run build && wrangler deploy --name seal-web-staging --domain staging-app.seal.nyc",
    "react:doctor": "vortex-react-doctor --diff",
    "react:doctor:full": "vortex-react-doctor --full --advisory",
    "cf:types:mkdir": "bun -e \"import { mkdirSync } from 'node:fs'; mkdirSync('.wrangler/types', { recursive: true })\"",
    "cf:types": "bun run cf:types:mkdir && wrangler types .wrangler/types/cloudflare-env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@convex-dev/agent": "0.3.2",
    "@convex-dev/presence": "0.3.2",
    "@convex-dev/react-query": "0.1.0",
    "@hookform/resolvers": "5.4.0",
    "@jam.dev/sdk": "0.0.6",
    "@radix-ui/react-accordion": "1.2.16",
    "@radix-ui/react-alert-dialog": "1.1.19",
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-progress": "1.1.12",
    "@radix-ui/react-radio-group": "1.4.3",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@react-input/number-format": "2.0.3",
    "@seal/backend": "workspace:*",
    "@seal/tokens": "workspace:*",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-virtual": "3.14.6",
