    "konva": "10.3.0",
    "lucide-react": "0.563.0",
    "next-themes": "0.4.6",
    "pdfjs-dist": "5.4.296",
    "posthog-js": "1.399.2",
    "radix-ui": "1.6.2",
    "react": "catalog:",
