    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.4.0",
    "happy-dom": "^20.6.1",
    "jsdom": "29.0.1",
    "react-grab": "^0.1.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.100.0"
  }
}
