{
  "name": "@vortex-api/seal",
  "version": "0.1.0",
  "description": "Seal SDK — typed API client, React signing components, and CLI",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    }
  },
  "bin": {
    "seal": "./bin/seal.mjs"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/docs/openapi.yaml -o ./src/openapi.ts",
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knip": "pnpm -w exec knip -W @vortex-api/seal",
    "knip:fix": "pnpm -w exec knip -W @vortex-api/seal --fix --allow-remove-files"
  },
  "dependencies": {
    "tsx": "^4.23.13"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "openapi-typescript": "7.13.0",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
