{
  "name": "@vortex-api/seal",
  "version": "0.1.0",
  "description": "Seal SDK — typed API client, React signing components, and CLI",
  "license": "MIT",
  "bin": {
    "seal": "./bin/seal.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "pnpm dlx openapi-typescript@7.13.0 ../../apps/docs/openapi.yaml -o ./src/openapi.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knip": "pnpm -w exec knip -W @vortex-api/seal",
    "knip:fix": "pnpm -w exec knip -W @vortex-api/seal --fix --allow-remove-files"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "openapi-typescript": "7.13.0",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
