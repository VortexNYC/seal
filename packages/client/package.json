{
  "name": "@seal/client",
  "version": "0.1.0",
  "description": "Generic, typed Seal API client generated from OpenAPI",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/docs/openapi.yaml -o ./src/openapi.ts",
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "catalog:"
  }
}
