{
  "name": "@seal/react",
  "version": "0.1.0",
  "description": "React SDK for embedding Seal signing experiences",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
