{
  "name": "@seal/transactional",
  "private": true,
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    }
  },
  "scripts": {
    "dev": "email dev -p 3001",
    "export": "email export",
    "lint": "vp lint .",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "knip": "pnpm -w exec knip -W @seal/transactional",
    "knip:fix": "pnpm -w exec knip -W @seal/transactional --fix --allow-remove-files"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@seal/tokens": "workspace:*",
    "react": "catalog:",
    "react-email": "6.9.5"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
