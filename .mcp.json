{
  "mcpServers": {
    "convex": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "convex@latest", "mcp", "start"]
    },
    "linear-vortex": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {}
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "vercel-vortex": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "seal-mcp": {
      "type": "http",
      "url": "https://mcp.seal.nyc/mcp"
    }
  }
}
