{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "indentStyle": "tab",
  "indentWidth": 2,
  "quoteStyle": "double",
  "sortPackageJson": true,
  "experimentalSortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"]],
    "internalPattern": ["@/"],
    "newlinesBetween": true,
    "ignoreCase": true
  },
  "experimentalTailwindcss": {
    "attributes": ["class", "className", "textClassName"],
    "functions": ["clsx", "cn", "cva", "tw", "twMerge"]
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/.next",
    "**/.turbo",
    "**/.cache",
    "**/_generated",
    "**/dist",
    "**/out",
    "**/public",
    "**/playwright-report",
    "**/playwright-results",
    "**/.expo",
    "**/.auth",
    "**/coverage",
    "**/src-tauri",
    "**/.output",
    "**/playwright/.auth",
    "**/convex/_generated/**",
    "**/apps/backend/convex/_generated/**",
    "**/next-env.d.ts",
    "**/*.d.ts",
    "**/src/app/globals.css",
    "**/.auth",
    "**/.whatsapp-auth",
    "**/test-results"
  ]
}
