{
  "name": "vortex-sign",
  "version": "0.0.1",
  "private": true,
  "description": "Vortex Sign — open-source, agent-native e-signature platform",
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev --filter @seal/backend --filter @seal/web --filter @seal/landing",
    "dev:web": "pnpm --dir apps/web run dev -- --host 0.0.0.0",
    "dev:landing": "pnpm --dir apps/landing run dev -- --host 0.0.0.0",
    "dev:all": "pnpm run dev",
    "build": "pnpm --filter @seal/web run build",
    "build:all": "vp run -r build",
    "test": "pnpm --filter @seal/web --filter @seal/backend run test",
    "typecheck": "pnpm --filter @seal/web --filter @seal/backend --filter @seal/react-sdk --filter @seal/transactional run typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "knip": "vp run -r knip",
    "fix": "vp lint --fix && vp fmt",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip",
    "verify:clean": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip",
    "clean": "(cd apps/backend && pnpm run clean) && (cd apps/web && pnpm run clean) && git clean -xdf .cache dist node_modules"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "@vortexnyc/tooling": "0.11.25",
    "knip": "^6.3.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite-plus": "0.2.4"
  },
  "packageManager": "pnpm@11.13.1"
}
