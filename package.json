{
  "name": "seal",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@types/bun": "1.3.11",
      "@types/node": "^25.5.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "convex": "^1.34.1",
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "typescript": "^5.9.3",
      "vite": "^8.0.3",
      "vitest": "^4.1.2",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@seal/backend --filter=@seal/web --filter=@seal/landing",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "prove:vortex-billing-settings-adoption": "bun run scripts/prove-vortex-billing-settings-adoption.ts",
    "prove:vortex-payments-settings-adoption": "bun run scripts/prove-vortex-payments-settings-adoption.ts",
    "knip": "turbo run knip",
    "knip:fix": "(cd apps/backend && bun run knip:fix) && (cd packages/react-sdk && bun run knip:fix) && (cd packages/transactional && bun run knip:fix) && (cd apps/web && bun run knip:fix)",
    "verify": "bun run lint && bun run format:check && bun run typecheck && bun run knip",
    "test": "turbo run test",
    "clean": "(cd apps/backend && bun run clean) && (cd apps/web && bun run clean) && git clean -xdf .cache .turbo dist node_modules",
    "eval": "cd evals && npx promptfoo eval",
    "eval:redteam": "cd evals && npx promptfoo eval -c redteam.yaml",
    "eval:all": "cd evals && npx promptfoo eval && npx promptfoo eval -c redteam.yaml",
    "eval:view": "npx promptfoo view"
  },
  "dependencies": {
    "@tanstack/router-core": "1.168.9",
    "posthog-js": "^1.364.7"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "baseline-browser-mapping": "^2.10.14",
    "browserslist": "^4.28.2",
    "knip": "^6.3.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "promptfoo": "^0.121.3",
    "turbo": "^2.9.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
