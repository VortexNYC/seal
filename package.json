{
	"name": "seal",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"tooling/*"
	],
	"packageManager": "bun@1.3.0",
	"resolutions": {
		"unplugin": "2.1.2",
		"csstype": "3.1.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"vite": "7.3.0"
	},
	"scripts": {
		"build": "turbo run build",
		"lint": "turbo run lint --continue",
		"format": "turbo run format --continue",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"knip": "turbo run knip --continue",
		"knip:fix": "turbo run knip:fix --continue",
		"static-analysis": "turbo run lint typecheck knip --continue && bun run biome:check",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"clean:workspaces": "turbo run clean"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@seal/tsconfig": "workspace:*",
		"@types/bun": "^1.3.5",
		"@types/node": "^25.0.3",
		"knip": "^5.78.0",
		"turbo": "^2.7.2",
		"typescript": "^5.9.3"
	}
}
