{
  "name": "seal",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@types/bun": "1.3.11",
      "@types/node": "^25.5.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "convex": "^1.41.0",
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "typescript": "^5.9.3",
      "vite": "^8.0.3",
      "vite-node": "^6.0.0",
      "vitest": "^4.1.2",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@seal/backend --filter=@seal/web --filter=@seal/landing",
    "dev:web": "cd apps/web && bun run dev -- --host 0.0.0.0",
    "dev:landing": "cd apps/landing && bun run dev -- --host 0.0.0.0",
    "dev:all": "bun run dev",
    "build": "turbo run build",
    "lint": "vortex-lint .",
    "lint:fix": "vortex-lint --fix --fix-suggestions --fix-dangerously .",
    "format": "vortex-format --ignore-path .oxfmtignore --write .",
    "format:check": "vortex-format --ignore-path .oxfmtignore --check .",
    "format:changed:check": "vortex-format --ignore-path .oxfmtignore --changed --check",
    "typecheck": "turbo run typecheck",
    "prove:vortex-billing-settings-adoption": "bun run scripts/prove-vortex-billing-settings-adoption.ts",
    "prove:vortex-payments-settings-adoption": "bun run scripts/prove-vortex-payments-settings-adoption.ts",
    "prove:vortex-merchant-settings-adoption": "bun run scripts/prove-vortex-merchant-settings-adoption.ts",
    "prove:vortex-operational-payments-adoption": "bun run scripts/prove-vortex-operational-payments-adoption.ts",
    "prove:vortex-payments-backend-adapter-adoption": "bun run scripts/prove-vortex-payments-backend-adapter-adoption.ts",
    "knip": "turbo run knip",
    "knip:fix": "(cd apps/backend && bun run knip:fix) && (cd packages/react-sdk && bun run knip:fix) && (cd packages/transactional && bun run knip:fix) && (cd apps/web && bun run knip:fix)",
    "verify": "bun run lint && bun run format:changed:check && bun run typecheck && bun run knip",
    "test": "turbo run test",
    "clean": "(cd apps/backend && bun run clean) && (cd apps/web && bun run clean) && git clean -xdf .cache .turbo dist node_modules",
    "eval": "cd evals && promptfoo eval",
    "eval:redteam": "cd evals && promptfoo eval -c redteam.yaml",
    "eval:all": "cd evals && promptfoo eval && promptfoo eval -c redteam.yaml",
    "eval:view": "promptfoo view",
    "migrate:legacy-auth-package:check": "vortex-migrate legacy-auth-package --check --root .",
    "project-kit:check": "vortex-project-kit --check --root .",
    "project-kit:doctor": "vortex-project-kit doctor --root .",
    "react:doctor": "vortex-react-doctor --diff",
    "react:doctor:full": "vortex-react-doctor --full --advisory",
    "repo:status": "vortex-repo-check --status .",
    "repo:check": "vortex-repo-check .",
    "check:preferred-stack": "vortex-stack-check .",
    "convex:insights": "bunx convex insights --details",
    "convex:insights:prod": "bunx convex insights --prod --details",
    "auth:check": "vortex-auth check --convex-dir ./apps/backend/convex",
    "auth:preflight": "vortex-auth preflight --repo-root . --convex-dir ./apps/backend/convex --",
    "lint:strict": "vortex-lint --strict .",
    "lint:advisory": "vortex-lint --strict --advisory ."
  },
  "dependencies": {
    "@tanstack/router-core": "1.168.9"
  },
  "devDependencies": {
    "@plasmapos/auth": "0.5.1",
    "@plasmapos/tooling": "0.2.13",
    "@seal/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "baseline-browser-mapping": "^2.10.14",
    "browserslist": "^4.28.2",
    "knip": "^6.3.0",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "promptfoo": "^0.121.3",
    "turbo": "^2.9.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
