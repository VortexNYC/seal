{
  "name": "seal",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.6",
      "@types/node": "^25.0.10",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "convex": "^1.32.0",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "typescript": "^5.9.3",
      "vite": "^7.3.1",
      "vitest": "^4.0.18",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@seal/backend --filter=@seal/web --filter=@seal/landing",
    "build": "turbo run build",
    "lint": "turbo run lint --filter=@seal/backend --filter=@seal/mcp-server --filter=@seal/react --filter=@seal/transactional --filter=@seal/web",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "turbo run format:check --filter=@seal/backend --filter=@seal/react --filter=@seal/transactional",
    "typecheck": "turbo run typecheck --filter=@seal/backend --filter=@seal/landing --filter=@seal/mcp-server --filter=@seal/react --filter=@seal/transactional --filter=@seal/web",
    "knip": "turbo run knip --continue --filter=@seal/backend --filter=@seal/mcp-server --filter=@seal/react --filter=@seal/transactional --filter=@seal/web",
    "knip:fix": "turbo run knip:fix --continue --filter=@seal/backend --filter=@seal/mcp-server --filter=@seal/react --filter=@seal/transactional --filter=@seal/web",
    "static-analysis": "bun run lint && bun run format:check && bun run typecheck && bun run knip",
    "test": "turbo run test --filter=@seal/backend --filter=@seal/mcp-server --filter=@seal/web",
    "clean": "bunx turbo run clean --filter=@seal/backend --filter=@seal/mcp-server --filter=@seal/web && git clean -xdf .cache .turbo dist node_modules",
    "eval": "cd evals && npx promptfoo eval",
    "eval:redteam": "cd evals && npx promptfoo eval -c redteam.yaml",
    "eval:all": "cd evals && npx promptfoo eval && npx promptfoo eval -c redteam.yaml",
    "eval:view": "npx promptfoo view"
  },
  "dependencies": {
    "posthog-js": "^1.360.1"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "knip": "^5.85.0",
    "oxfmt": "^0.37.0",
    "oxlint": "^1.52.0",
    "promptfoo": "^0.121.2",
    "turbo": "^2.8.15",
    "typescript": "catalog:"
  },
  "resolutions": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "csstype": "3.1.3",
    "rollup": "4.55.1",
    "unplugin": "2.1.2",
    "vite": "^7.3.1"
  },
  "packageManager": "bun@1.3.0"
}
