{
  "name": "vortex-sign",
  "version": "0.0.1",
  "private": true,
  "description": "Seal — open-source, agent-native e-signature platform",
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev --filter @vortex/sign-api --filter @seal/web --filter @seal/landing",
    "dev:web": "pnpm --dir apps/web run dev -- --host 0.0.0.0",
    "dev:landing": "pnpm --dir apps/landing run dev -- --host 0.0.0.0",
    "dev:all": "pnpm run dev",
    "build": "pnpm --filter @seal/web run build",
    "build:all": "vp run -r build",
    "deploy": "vp run -F @seal/anydoc-worker deploy && vp run -F @seal/convert-worker deploy && vp run -F @vortex/sign-api deploy && vp run -F @seal/mcp-worker deploy && vp run -F @seal/web deploy",
    "test": "pnpm --filter @vortex/sign-api --filter @seal/web run test",
    "typecheck": "pnpm --filter @vortex/sign-api --filter @seal/web --filter @seal/react --filter @seal/transactional --filter @seal/client --filter seal-cli --filter @seal/convert-worker run typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "knip": "vp run -r knip",
    "scan:secrets": "secretlint . --no-gitignore --secretlintignore .secretlintignore",
    "fix": "vp lint --fix && vp fmt",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip",
    "verify:clean": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip",
    "clean": "(cd apps/web && pnpm run clean) && git clean -xdf .cache dist node_modules"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@shadcn/lint": "^0.1.0",
    "knip": "^6.3.0",
    "secretlint": "^13.0.5",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite-plus": "0.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run scan:secrets"
  },
  "packageManager": "pnpm@11.13.1"
}
