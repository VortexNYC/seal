{
	"name": "seal",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"tooling/*"
	],
	"catalog": {
		"@biomejs/biome": "^2.3.11",
		"@types/bun": "^1.3.6",
		"@types/node": "^25.0.10",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"convex": "^1.31.6",
		"knip": "^5.82.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"zod": "^4.3.6"
	},
	"packageManager": "bun@1.3.0",
	"resolutions": {
		"unplugin": "2.1.2",
		"csstype": "3.1.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"vite": "^7.3.1"
	},
	"scripts": {
		"build": "turbo run build",
		"lint": "turbo run lint --continue",
		"format": "turbo run format --continue",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"knip": "turbo run knip --continue",
		"knip:fix": "turbo run knip:fix --continue",
		"static-analysis": "turbo run lint typecheck knip --continue && bun run biome:check",
		"clean": "git clean -xdf .cache .tanstack .turbo dist node_modules",
		"clean:workspaces": "turbo run clean"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@seal/tsconfig": "workspace:*",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"knip": "catalog:",
		"turbo": "^2.7.6",
		"typescript": "catalog:"
	}
}
