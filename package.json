{
	"name": "seal",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"tooling/*"
	],
	"packageManager": "bun@1.3.0",
	"resolutions": {
		"unplugin": "2.1.2",
		"csstype": "3.1.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3"
	},
	"scripts": {
		"build": "turbo run build",
		"lint": "turbo run lint --continue",
		"format": "turbo run format --continue",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"static-analysis": "bun run biome:check && bun run typecheck",
		"typecheck": "turbo run typecheck",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"clean:workspaces": "turbo run clean"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@seal/tsconfig": "workspace:*",
		"@types/bun": "^1.3.4",
		"@types/node": "^24.10.3",
		"turbo": "^2.6.3",
		"typescript": "^5.9.3"
	}
}
