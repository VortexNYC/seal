{
  "name": "seal",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vp run -r dev --filter @seal/backend --filter @seal/web --filter @seal/landing",
    "dev:web": "pnpm --dir apps/web run dev -- --host 0.0.0.0",
    "dev:landing": "pnpm --dir apps/landing run dev -- --host 0.0.0.0",
    "dev:all": "pnpm run dev",
    "build": "vp run -r build --filter=!@seal/landing",
    "lint": "vp lint && pnpm run lint:convex",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp run -r typecheck",
    "prove:vortex-billing-settings-adoption": "pnpm exec tsx scripts/prove-vortex-billing-settings-adoption.ts",
    "prove:vortex-payments-settings-adoption": "pnpm exec tsx scripts/prove-vortex-payments-settings-adoption.ts",
    "prove:vortex-merchant-settings-adoption": "pnpm exec tsx scripts/prove-vortex-merchant-settings-adoption.ts",
    "prove:seal-account-onboarding-vortex-local": "pnpm --dir apps/backend exec vitest run --maxWorkers=1 convex/organizations/__tests__/account_creation.test.ts convex/payments/merchant_account_actions.test.ts convex/payments/vortex_merchant_queries.test.ts convex/vortex_billing/payable_actions.test.ts",
    "prove:seal-vortex-onboarding-wiring": "pnpm exec tsx scripts/prove-seal-vortex-onboarding-wiring.ts",
    "prove:seal-catalog-from-vortex": "pnpm exec tsx scripts/prove-seal-catalog-from-vortex.ts",
    "prove:seal-coupons-vortex": "pnpm exec tsx scripts/prove-seal-coupons-vortex.ts",
    "prove:seal-saas-checkout-vortex": "pnpm exec tsx scripts/prove-seal-saas-checkout-vortex.ts",
    "prove:seal-saas-vortex-local": "pnpm --dir apps/backend exec vitest run --maxWorkers=1 convex/payments/subscription_actions.test.ts convex/payments/vortex_billing_processor.test.ts",
    "prove:seal-saas-webhook-billing-state": "pnpm exec tsx scripts/prove-seal-saas-webhook-billing-state.ts",
    "prove:seal-vortex-migration-local": "pnpm exec tsx scripts/prove-seal-vortex-migration-local.ts",
    "prove:seal-document-payment-vortex-local": "pnpm exec tsx scripts/prove-seal-document-payment-vortex-local.ts",
    "prove:seal-document-payment-vortex-live": "pnpm exec tsx scripts/prove-seal-document-payment-vortex-live.ts",
    "prove:seal-document-payment-vortex-paid-state": "pnpm exec tsx scripts/prove-seal-document-payment-vortex-paid-state.ts",
    "prove:seal-vortex-production-proof-boundary": "pnpm exec tsx scripts/prove-seal-vortex-production-proof-boundary.ts",
    "prove:vortex-operational-payments-adoption": "pnpm exec tsx scripts/prove-vortex-operational-payments-adoption.ts",
    "prove:vortex-payments-backend-adapter-adoption": "pnpm exec tsx scripts/prove-vortex-payments-backend-adapter-adoption.ts",
    "prove:vortex-saas-webhook-projection": "pnpm --dir apps/backend exec vitest run --maxWorkers=1 convex/vortex_billing/__tests__/webhook_signature.test.ts convex/vortex_billing/__tests__/webhook_handlers.test.ts convex/vortex_billing/__tests__/webhook_projection.test.ts",
    "prove:zero-retired-provider-residue": "pnpm exec tsx scripts/prove-zero-retired-provider-residue.ts",
    "audit:seal-vortex-hosted-outcomes-boundary": "pnpm exec tsx scripts/audit-seal-vortex-hosted-outcomes-boundary.ts",
    "audit:seal-vortex-sandbox-settlement-boundary": "pnpm exec tsx scripts/audit-seal-vortex-sandbox-settlement-boundary.ts",
    "audit:seal-vortex-production-readiness": "pnpm exec tsx scripts/audit-seal-vortex-production-readiness.ts",
    "audit:seal-vortex-production-proof-boundary": "pnpm exec tsx scripts/audit-seal-vortex-production-proof-boundary.ts",
    "audit:seal-vortex-launch-boundary": "pnpm exec tsx scripts/audit-seal-vortex-launch-boundary.ts",
    "audit:qa-feature-tracker": "pnpm exec tsx scripts/audit-qa-feature-tracker.ts",
    "verify:seal-vortex-migration": "pnpm run prove:zero-retired-provider-residue && pnpm run prove:seal-vortex-migration-local",
    "knip": "vp run -r knip",
    "knip:fix": "(cd apps/backend && pnpm run knip:fix) && (cd packages/react-sdk && pnpm run knip:fix) && (cd packages/transactional && pnpm run knip:fix) && (cd apps/web && pnpm run knip:fix)",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip && pnpm run check:ui-conformance && pnpm run verify:seal-vortex-migration",
    "verify:clean": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip && pnpm run check:ui-conformance && pnpm run prove:zero-retired-provider-residue",
    "test": "vp run -r test",
    "clean": "(cd apps/backend && pnpm run clean) && (cd apps/web && pnpm run clean) && git clean -xdf .cache .turbo dist node_modules",
    "eval": "cd evals && pnpm dlx promptfoo eval",
    "eval:redteam": "cd evals && pnpm dlx promptfoo eval -c redteam.yaml",
    "eval:all": "cd evals && pnpm dlx promptfoo eval && pnpm dlx promptfoo eval -c redteam.yaml",
    "eval:view": "pnpm dlx promptfoo view",
    "migrate:legacy-auth-package:check": "vortex-migrate legacy-auth-package --check --root .",
    "project-kit:check": "vortex-project-kit --check --root .",
    "project-kit:doctor": "vortex-project-kit doctor --root .",
    "react:doctor": "vortex-react-doctor --diff",
    "react:doctor:full": "vortex-react-doctor --full --advisory",
    "repo:status": "vortex-repo-check --status .",
    "repo:check": "vortex-repo-check .",
    "check:preferred-stack": "vortex-stack-check .",
    "convex:insights": "pnpm dlx convex insights --details",
    "convex:insights:prod": "pnpm dlx convex insights --prod --details",
    "auth:check": "vortex-auth check --convex-dir ./apps/backend/convex",
    "auth:preflight": "vortex-auth preflight --repo-root . --convex-dir ./apps/backend/convex --",
    "check:ui-conformance": "vortex-ui-conformance .",
    "lint:convex": "eslint -c node_modules/@vortexnyc/tooling/convex-lint/eslint.config.mjs .",
    "prepare": "lefthook install",
    "precommit:check": "pnpm run lint:convex",
    "prepush:check": "pnpm run project-kit:check && pnpm run project-kit:doctor && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build",
    "fix": "vp lint --fix && vp fmt",
    "check": "vp check"
  },
  "dependencies": {
    "@tanstack/router-core": "1.171.16",
    "@vortexnyc/convex": "0.7.2"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "2.0.0",
    "@seal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vortexnyc/auth": "0.14.3",
    "@vortexnyc/tooling": "0.11.14",
    "baseline-browser-mapping": "^2.10.14",
    "browserslist": "^4.28.2",
    "eslint": "10.7.0",
    "knip": "^6.3.0",
    "lefthook": "2.1.10",
    "promptfoo": "^0.121.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.63.0",
    "vite-plus": "0.2.4"
  },
  "packageManager": "pnpm@11.13.1"
}
