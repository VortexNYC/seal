{
  "name": "seal",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "turbo run typecheck",
    "knip": "turbo run knip --continue",
    "knip:fix": "turbo run knip:fix --continue",
    "static-analysis": "turbo run lint format:check typecheck knip --continue",
    "test": "turbo run test",
    "clean": "git clean -xdf .cache .tanstack .turbo dist node_modules",
    "clean:workspaces": "turbo run clean"
  },
  "devDependencies": {
    "@seal/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.8.0",
    "typescript": "catalog:"
  },
  "resolutions": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "csstype": "3.1.3",
    "unplugin": "2.1.2",
    "vite": "^7.3.1"
  },
  "packageManager": "bun@1.3.0",
  "catalog": {
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "convex": "^1.31.6",
    "knip": "^5.82.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  }
}
